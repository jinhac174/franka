<mujoco model="fr3_hand">
  <!-- Franka Research 3 arm + Franka Hand, torque-actuated.

       Arm: mujoco_menagerie/franka_fr3 (Apache-2.0), derived from
       franka_description. Hand: mujoco_menagerie/franka_emika_panda/hand.xml
       (the same Franka Hand ships on the FR3).

       Changes vs menagerie:
         * Position servos replaced by torque motors. SimFrankaFR3 computes
           tau = kp*(q_des-q) + kd*(qd_des-qd) + tau_ff and writes ctrl[].
         * Hand attached at the flange (link7 + 0.107 m, -45 deg about z), as in
           the URDF (fr3_joint8 + fr3_hand_joint).
         * Body / joint names match the URDF (fr3_link*, fr3_hand,
           fr3_leftfinger, fr3_finger_joint*) so MuJoCo, Pinocchio and Viser
           share one naming scheme.
         * Gripper driven by one force motor on the finger-width tendon (see
           below); SimFrankaFR3 emulates the real gripper's move/grasp API on
           top of it.

       Joint ranges are the FR3 datasheet limits (menagerie values), which are
       slightly tighter than franka_description 2.x. Gravity compensation is
       NOT in this file: the platform sets body_gravcomp at load time to mimic
       the FR3 firmware, which compensates gravity internally. -->
  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="fr3">
      <!-- Overwritten in joints 5, 6, and 7. -->
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
    <default class="hand">
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04" armature="0.1" damping="1"/>
      </default>
      <default class="hand_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <!-- Gripper contact: sliding friction mu = 0.8 (rubber-like fingertips),
           torsional friction gamma = 8 mm (condim 4) so a two-finger grasp can
           resist twisting about its closing axis. utils/grasping/parallel_jaw.py
           uses the same mu / gamma to predict the required grip force. -->
      <default class="hand_collision">
        <geom type="mesh" group="3" friction="0.8 0.008 0.0001" condim="4"/>
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="black" rgba=".2 .2 .2 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="red" rgba="1 0.072272 0.039546 1"/>
    <material name="gray" rgba="0.863156 0.863156 0.863157 1"/>
    <material name="button_green" rgba="0.102241 0.571125 0.102242 1"/>
    <material name="button_red" rgba="0.520996 0.008023 0.013702 1"/>
    <material name="button_blue" rgba="0.024157 0.445201 0.737911 1"/>
    <material name="hand_white" rgba="1 1 1 1" specular="0.5" shininess="0.25"/>
    <material name="hand_off_white" rgba="0.901961 0.921569 0.929412 1" specular="0.5" shininess="0.25"/>
    <material name="hand_black" rgba="0.25 0.25 0.25 1" specular="0.5" shininess="0.25"/>

    <mesh file="meshes/fr3/link0_0.obj"/>
    <mesh file="meshes/fr3/link0_1.obj"/>
    <mesh file="meshes/fr3/link0_2.obj"/>
    <mesh file="meshes/fr3/link0_3.obj"/>
    <mesh file="meshes/fr3/link0_4.obj"/>
    <mesh file="meshes/fr3/link0_5.obj"/>
    <mesh file="meshes/fr3/link0_6.obj"/>
    <mesh file="meshes/fr3/link1.obj"/>
    <mesh file="meshes/fr3/link2.obj"/>
    <mesh file="meshes/fr3/link3_0.obj"/>
    <mesh file="meshes/fr3/link3_1.obj"/>
    <mesh file="meshes/fr3/link4_0.obj"/>
    <mesh file="meshes/fr3/link4_1.obj"/>
    <mesh file="meshes/fr3/link5_0.obj"/>
    <mesh file="meshes/fr3/link5_1.obj"/>
    <mesh file="meshes/fr3/link5_2.obj"/>
    <mesh file="meshes/fr3/link6_0.obj"/>
    <mesh file="meshes/fr3/link6_1.obj"/>
    <mesh file="meshes/fr3/link6_2.obj"/>
    <mesh file="meshes/fr3/link6_3.obj"/>
    <mesh file="meshes/fr3/link6_4.obj"/>
    <mesh file="meshes/fr3/link6_5.obj"/>
    <mesh file="meshes/fr3/link6_6.obj"/>
    <mesh file="meshes/fr3/link6_7.obj"/>
    <mesh file="meshes/fr3/link7_0.obj"/>
    <mesh file="meshes/fr3/link7_1.obj"/>
    <mesh file="meshes/fr3/link7_2.obj"/>
    <mesh file="meshes/fr3/link7_3.obj"/>

    <mesh name="link0_coll" file="meshes/fr3/link0.stl"/>
    <mesh name="link1_coll" file="meshes/fr3/link1.stl"/>
    <mesh name="link2_coll" file="meshes/fr3/link2.stl"/>
    <mesh name="link3_coll" file="meshes/fr3/link3.stl"/>
    <mesh name="link4_coll" file="meshes/fr3/link4.stl"/>
    <mesh name="link5_coll" file="meshes/fr3/link5.stl"/>
    <mesh name="link6_coll" file="meshes/fr3/link6.stl"/>
    <mesh name="link7_coll" file="meshes/fr3/link7.stl"/>

    <mesh name="hand_c" file="meshes/hand/hand.stl"/>
    <mesh file="meshes/hand/hand_0.obj"/>
    <mesh file="meshes/hand/hand_1.obj"/>
    <mesh file="meshes/hand/hand_2.obj"/>
    <mesh file="meshes/hand/hand_3.obj"/>
    <mesh file="meshes/hand/hand_4.obj"/>
    <mesh file="meshes/hand/finger_0.obj"/>
    <mesh file="meshes/hand/finger_1.obj"/>
  </asset>

  <worldbody>
    <body name="base" childclass="fr3">
      <body name="fr3_link0">
        <geom mesh="link0_0" material="black" class="visual"/>
        <geom mesh="link0_1" material="white" class="visual"/>
        <geom mesh="link0_2" material="white" class="visual"/>
        <geom mesh="link0_3" material="white" class="visual"/>
        <geom mesh="link0_4" material="white" class="visual"/>
        <geom mesh="link0_5" material="red" class="visual"/>
        <geom mesh="link0_6" material="black" class="visual"/>
        <geom name="fr3_link0_collision" mesh="link0_coll" class="collision"/>
        <body name="fr3_link1" pos="0 0 0.333">
          <inertial pos="4.128e-07 -0.0181251 -0.0386036" quat="0.998098 -0.0605364 0.00380499 0.0110109" mass="2.92747"
            diaginertia="0.0239286 0.0227246 0.00610634"/>
          <joint name="fr3_joint1" axis="0 0 1" range="-2.7437 2.7437" actuatorfrcrange="-87 87"/>
          <geom name="fr3_link1_collision" class="collision" mesh="link1_coll"/>
          <geom material="white" mesh="link1" class="visual"/>
          <body name="fr3_link2" quat="1 -1 0 0">
            <inertial pos="0.00318289 -0.0743222 0.00881461" quat="0.502599 0.584437 -0.465998 0.434366" mass="2.93554"
              diaginertia="0.0629567 0.0411924 0.0246371"/>
            <joint name="fr3_joint2" axis="0 0 1" range="-1.7837 1.7837" actuatorfrcrange="-87 87"/>
            <geom material="white" mesh="link2" class="visual"/>
            <geom name="fr3_link2_collision" class="collision" mesh="link2_coll"/>
            <body name="fr3_link3" pos="0 -0.316 0" quat="1 1 0 0">
              <inertial pos="0.0407016 -0.00482006 -0.0289731" quat="0.921025 -0.244161 0.155272 0.260745" mass="2.2449"
                diaginertia="0.0267409 0.0189869 0.0171587"/>
              <joint name="fr3_joint3" axis="0 0 1" range="-2.9007 2.9007" actuatorfrcrange="-87 87"/>
              <geom mesh="link3_0" material="white" class="visual"/>
              <geom mesh="link3_1" material="black" class="visual"/>
              <geom name="fr3_link3_collision" class="collision" mesh="link3_coll"/>
              <body name="fr3_link4" pos="0.0825 0 0" quat="1 1 0 0">
                <inertial pos="-0.0459101 0.0630493 -0.00851879" quat="0.438018 0.803311 0.00937812 0.403414"
                  mass="2.6156" diaginertia="0.05139 0.0372717 0.0160047"/>
                <joint name="fr3_joint4" axis="0 0 1" range="-3.0421 -0.1518" actuatorfrcrange="-87 87"/>
                <geom mesh="link4_0" material="white" class="visual"/>
                <geom mesh="link4_1" material="black" class="visual"/>
                <geom name="fr3_link4_collision" class="collision" mesh="link4_coll"/>
                <body name="fr3_link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                  <inertial pos="-0.00160396 0.0292536 -0.0972966" quat="0.919031 0.125604 0.0751531 -0.366003"
                    mass="2.32712" diaginertia="0.0579335 0.0449144 0.0130634"/>
                  <joint name="fr3_joint5" axis="0 0 1" range="-2.8065 2.8065" actuatorfrcrange="-12 12"
                    armature="0.074" frictionloss="0.763"/>
                  <geom mesh="link5_0" material="white" class="visual"/>
                  <geom mesh="link5_1" material="white" class="visual"/>
                  <geom mesh="link5_2" material="black" class="visual"/>
                  <geom name="fr3_link5_collision" class="collision" mesh="link5_coll"/>
                  <body name="fr3_link6" quat="1 1 0 0">
                    <inertial pos="0.0597131 -0.0410295 -0.0101693" quat="0.621301 0.552665 0.510011 0.220081"
                      mass="1.81704" diaginertia="0.0175039 0.0161123 0.00193529"/>
                    <joint name="fr3_joint6" axis="0 0 1" range="0.5445 4.5169" actuatorfrcrange="-12 12"
                      armature="0.074" frictionloss="0.44"/>
                    <geom mesh="link6_0" material="button_green" class="visual"/>
                    <geom mesh="link6_1" material="white" class="visual"/>
                    <geom mesh="link6_2" material="white" class="visual"/>
                    <geom mesh="link6_3" material="gray" class="visual"/>
                    <geom mesh="link6_4" material="button_red" class="visual"/>
                    <geom mesh="link6_5" material="white" class="visual"/>
                    <geom mesh="link6_6" material="black" class="visual"/>
                    <geom mesh="link6_7" material="button_blue" class="visual"/>
                    <geom name="fr3_link6_collision" class="collision" mesh="link6_coll"/>
                    <body name="fr3_link7" pos="0.088 0 0" quat="1 1 0 0">
                      <inertial pos="0.00452258 0.00862619 -0.0161633" quat="0.727579 0.0978688 -0.24906 0.63168"
                        mass="0.627143" diaginertia="0.000223836 0.000223642 5.64132e-07"/>
                      <joint name="fr3_joint7" axis="0 0 1" range="-3.0159 3.0159" actuatorfrcrange="-12 12"
                        armature="0.074" frictionloss="0.248"/>
                      <geom mesh="link7_0" material="black" class="visual"/>
                      <geom mesh="link7_1" material="white" class="visual"/>
                      <geom mesh="link7_2" material="white" class="visual"/>
                      <geom mesh="link7_3" material="black" class="visual"/>
                      <geom name="fr3_link7_collision" class="collision" mesh="link7_coll"/>

                      <!-- Flange (URDF fr3_link8) + Franka Hand (URDF fr3_hand). -->
                      <body name="fr3_hand" pos="0 0 0.107" quat="0.9238795 0 0 -0.3826834" childclass="hand">
                        <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
                        <geom mesh="hand_0" material="hand_off_white" class="hand_visual"/>
                        <geom mesh="hand_1" material="hand_black" class="hand_visual"/>
                        <geom mesh="hand_2" material="hand_black" class="hand_visual"/>
                        <geom mesh="hand_3" material="hand_white" class="hand_visual"/>
                        <geom mesh="hand_4" material="hand_off_white" class="hand_visual"/>
                        <geom name="fr3_hand_collision" mesh="hand_c" class="hand_collision"/>
                        <!-- Tool centre point between the fingertips (URDF fr3_hand_tcp). -->
                        <site name="fr3_hand_tcp" pos="0 0 0.1034" size="0.005" rgba="1 0 0 0.5" group="4"/>
                        <body name="fr3_leftfinger" pos="0 0 0.0584">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="fr3_finger_joint1" class="finger"/>
                          <geom mesh="finger_0" material="hand_off_white" class="hand_visual"/>
                          <geom mesh="finger_1" material="hand_black" class="hand_visual"/>
                          <geom mesh="finger_0" class="hand_collision"/>
                          <geom class="fingertip_pad_collision_1"/>
                          <geom class="fingertip_pad_collision_2"/>
                          <geom class="fingertip_pad_collision_3"/>
                          <geom class="fingertip_pad_collision_4"/>
                          <geom class="fingertip_pad_collision_5"/>
                        </body>
                        <body name="fr3_rightfinger" pos="0 0 0.0584" quat="0 0 0 1">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="fr3_finger_joint2" class="finger"/>
                          <geom mesh="finger_0" material="hand_off_white" class="hand_visual"/>
                          <geom mesh="finger_1" material="hand_black" class="hand_visual"/>
                          <geom mesh="finger_0" class="hand_collision"/>
                          <geom class="fingertip_pad_collision_1"/>
                          <geom class="fingertip_pad_collision_2"/>
                          <geom class="fingertip_pad_collision_3"/>
                          <geom class="fingertip_pad_collision_4"/>
                          <geom class="fingertip_pad_collision_5"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="fr3_link0" body2="fr3_link1"/>
    <exclude body1="fr3_hand" body2="fr3_leftfinger"/>
    <exclude body1="fr3_hand" body2="fr3_rightfinger"/>
  </contact>

  <!-- The two fingers are mechanically coupled on the real gripper. -->
  <tendon>
    <!-- Length = finger opening width (q1 + q2), in metres. -->
    <fixed name="gripper_width">
      <joint joint="fr3_finger_joint1" coef="1"/>
      <joint joint="fr3_finger_joint2" coef="1"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="fr3_finger_joint1" joint2="fr3_finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- Torque actuators. ctrlrange = FR3 joint torque limits (Nm). -->
  <actuator>
    <motor joint="fr3_joint1" name="motor_fr3_joint1" ctrlrange="-87 87"/>
    <motor joint="fr3_joint2" name="motor_fr3_joint2" ctrlrange="-87 87"/>
    <motor joint="fr3_joint3" name="motor_fr3_joint3" ctrlrange="-87 87"/>
    <motor joint="fr3_joint4" name="motor_fr3_joint4" ctrlrange="-87 87"/>
    <motor joint="fr3_joint5" name="motor_fr3_joint5" ctrlrange="-12 12"/>
    <motor joint="fr3_joint6" name="motor_fr3_joint6" ctrlrange="-12 12"/>
    <motor joint="fr3_joint7" name="motor_fr3_joint7" ctrlrange="-12 12"/>

    <!-- Gripper: position servo on the width tendon (ctrl = target width, m).
         kv is integrated implicitly, so it stays stable at these gains.
         forcerange caps the squeeze force; SimFrankaFR3 rewrites it per
         command (move: 70 N, grasp: the commanded force). 140 N is the
         Franka Hand's peak grasp force (70 N continuous). -->
    <general tendon="gripper_width" name="actuator_gripper" ctrlrange="0 0.08"
             forcerange="-140 140" dyntype="none" biastype="affine"
             gainprm="2000 0 0" biasprm="0 -2000 -100"/>
  </actuator>
</mujoco>
