<mujoco model="franka_fr3_cam_calib_scene">
  <include file="fr3_hand_robot.xml"/>

  <compiler angle="radian"/>

  <option timestep="0.001" integrator="implicitfast"/>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture name="groundplane" type="2d" builtin="checker"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             mark="edge" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane"
              texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 -0.1 1.5" dir="0 0.2 -1"
           diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           directional="true" castshadow="true"/>

    <!-- Collision geometries: the floor, a wall behind the arm (-x), and a wall
         to the side (-y). All use MuJoCo's default contype/conaffinity (1/1),
         so they collide with the robot's collision meshes.

         Positions/sizes are PLACEHOLDERS clear of the arm at its home pose;
         adjust to match the real cell. The walls are translucent so they don't
         obscure the arm. -->
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 0"
          group="0" material="groundplane"
          friction="0.5 0.02 0.02"/>
    <geom name="wall_back" type="box" size="0.05 0.85 0.9" pos="-0.5 0 0.9"
          rgba="0.55 0.57 0.62 0.3" friction="0.5 0.02 0.02"/>
    <geom name="wall_left" type="box" size="0.85 0.05 0.9" pos="0.2 -0.55 0.9"
          rgba="0.55 0.57 0.62 0.3" friction="0.5 0.02 0.02"/>

    <!-- Fixed RGB-D camera for base-camera calibration (tutorial 14), in front
         of the robot on the +y side, looking at the middle of the arm. On the
         real robot this pose is what the calibration estimates. -->
    <body name="calib_camera" pos="1.0 0.65 0.75"
          xyaxes="-0.5855 0.8107 0  -0.2748 -0.1985 0.9408">
      <camera name="calib_camera" mode="fixed" pos="0 0 0" euler="0 0 0" fovy="55"/>
      <geom name="calib_camera_marker" type="box" size="0.03 0.01 0.015"
            rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
